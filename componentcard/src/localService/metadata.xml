<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0"
    xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
  <edmx:DataServices m:DataServiceVersion="2.0"
      xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <Schema Namespace="MockService" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
      <EntityType Name="User">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.String" Nullable="false" MaxLength="36"/>
        <Property Name="Name" Type="Edm.String" Nullable="true" MaxLength="100"/>
        <Property Name="Email" Type="Edm.String" Nullable="true" MaxLength="100"/>
      </EntityType>

      <EntityContainer Name="MockServiceEntities" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Users" EntityType="MockService.User" />
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>